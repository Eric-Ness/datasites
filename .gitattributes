# Normalize line endings to LF everywhere. Content hashes of generated files
# must match between Windows and Linux CI.
* text=auto eol=lf

*.parquet binary
*.png binary
*.ico binary
*.gz binary

# Verbatim captures of upstream responses (USDM answers with CRLF); tests depend on the exact bytes.
pipelines/tests/water/fixtures/** -text
# MEDSL's files exactly as Dataverse serves them (CRLF); the pipelines check their MD5 against Dataverse's.
data/sources/medsl/** -text
data/sources/medsl/README.md text eol=lf
