// justicedata.dev: an assets-only Worker (no script) serving the static site built into ../dist/justicedata.
// Build first:  SITE=justicedata pnpm --filter @datasites/web run build
// Deploy:       pnpm --filter @datasites/web exec wrangler deploy -c wrangler/justicedata.jsonc
// Not deployed yet (status coming-soon): add the site to WEB_SITES in deploy.yml and api.justicedata.dev /
// www.justicedata.dev routes, and set status: live, in the launch change.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "web-justicedata",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "../dist/justicedata",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "justicedata.dev", "custom_domain": true }
  ]
}
