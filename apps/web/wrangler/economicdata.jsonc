// economicdata.dev: an assets-only Worker (no script) serving the static site built into ../dist/economicdata.
// Build first:  SITE=economicdata pnpm --filter @datasites/web run build
// Deploy:       pnpm --filter @datasites/web exec wrangler deploy -c wrangler/economicdata.jsonc
// The apex domain is served by the coming-soon Worker until it is removed there; see apps/web/README.md.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "web-economicdata",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "../dist/economicdata",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "economicdata.dev", "custom_domain": true }
  ]
}
