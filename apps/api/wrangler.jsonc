// One API Worker serves every site at api.<domain>; the site is picked from the Host header.
// env.staging deploys to datasites-api-staging.<account>.workers.dev, where ?site=<id> picks the site
// (deploy-staging.yml); it reads the datasites-data-staging bucket.
// Add a site's route only once its zone is Active in Cloudflare, or the deploy fails.
//
// Bindings that need nothing more:
//   KEYS:  the datasites-api-keys KV namespace (created 2026-10-25). Staging has none yet; see env.staging.
//   USAGE: Analytics Engine datasets are created on first write; nothing to create.
//   UsageCounter: the Durable Object class is created by the v1 migration on deploy.
// Stripe secrets are optional; without them billing stays inert:
//   pnpm exec wrangler secret put STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "datasites-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "routes": [
    { "pattern": "api.airdata.dev", "custom_domain": true },
    { "pattern": "api.carbondata.dev", "custom_domain": true },
    { "pattern": "api.climatedata.dev", "custom_domain": true },
    { "pattern": "api.economicdata.dev", "custom_domain": true },
    { "pattern": "api.electiondata.dev", "custom_domain": true },
    { "pattern": "api.healthdata.dev", "custom_domain": true },
    { "pattern": "api.housingdata.dev", "custom_domain": true },
    { "pattern": "api.satellitedata.dev", "custom_domain": true },
    { "pattern": "api.visualizedata.dev", "custom_domain": true },
    { "pattern": "api.waterdata.dev", "custom_domain": true },
    { "pattern": "api.wildfiredata.dev", "custom_domain": true }
  ],
  // Every 15 minutes: freshness check. 00:07 UTC: report the previous day's usage to Stripe.
  "triggers": { "crons": ["*/15 * * * *", "7 0 * * *"] },
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "datasites-data" }],
  "kv_namespaces": [{ "binding": "KEYS", "id": "23b85cb95ebf49aaac94c4238d85e67e" }], // datasites-api-keys, created 2026-10-25
  "ratelimits": [
    { "name": "RL_ANON", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_FREE", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_PRO", "namespace_id": "1004", "simple": { "limit": 6000, "period": 60 } }
  ],
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "datasites_api_usage" }],
  "durable_objects": { "bindings": [{ "name": "USAGE_COUNTER", "class_name": "UsageCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageCounter"] }],
  "vars": { "ENV": "production", "STRIPE_METER_EVENT": "api_requests" },
  "env": {
    "staging": {
      "name": "datasites-api-staging",
      "workers_dev": true,
      "routes": [],
      "triggers": { "crons": [] },
      "r2_buckets": [{ "binding": "DATA", "bucket_name": "datasites-data-staging" }],
      // No KEYS binding yet, so staging serves everyone anonymously and deploys without a KV namespace.
      // To try API keys on staging, create one (wrangler kv namespace create datasites-api-keys-staging) and
      // set: "kv_namespaces": [{ "binding": "KEYS", "id": "<its id>" }]
      "kv_namespaces": [],
      "ratelimits": [
        { "name": "RL_ANON", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } },
        { "name": "RL_FREE", "namespace_id": "1005", "simple": { "limit": 1200, "period": 60 } },
        { "name": "RL_PRO", "namespace_id": "1006", "simple": { "limit": 6000, "period": 60 } }
      ],
      "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "datasites_api_usage_staging" }],
      "durable_objects": { "bindings": [{ "name": "USAGE_COUNTER", "class_name": "UsageCounter" }] },
      "vars": { "ENV": "staging", "STRIPE_METER_EVENT": "api_requests" }
    }
  }
}
