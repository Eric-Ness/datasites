// One API Worker serves every site at api.<domain>; the site is picked from the Host header.
// Add a site's route only once its zone is Active in Cloudflare, or the deploy fails.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "datasites-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "routes": [
    { "pattern": "api.climatedata.dev", "custom_domain": true }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "datasites-data" }],
  "ratelimits": [
    { "name": "RL_ANON", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": { "ENV": "production" },
  "env": {
    "staging": {
      "name": "datasites-api-staging",
      "workers_dev": true,
      "routes": [],
      "triggers": { "crons": [] },
      "r2_buckets": [{ "binding": "DATA", "bucket_name": "datasites-data-staging" }],
      "ratelimits": [
        { "name": "RL_ANON", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
      ],
      "vars": { "ENV": "staging" }
    }
  }
}
