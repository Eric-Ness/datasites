// One Worker serves the placeholder page on every domain that has no real site yet.
// Routes can only be attached once each zone is Active in Cloudflare; remove any that aren't,
// and remove a domain here before deploying its real site Worker.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "datasites-coming-soon",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "routes": [
    { "pattern": "airdata.dev", "custom_domain": true },
    { "pattern": "carbondata.dev", "custom_domain": true },
    { "pattern": "climatedata.dev", "custom_domain": true },
    { "pattern": "economicdata.dev", "custom_domain": true },
    { "pattern": "electiondata.dev", "custom_domain": true },
    { "pattern": "satellitedata.dev", "custom_domain": true },
    { "pattern": "visualizedata.dev", "custom_domain": true },
    { "pattern": "waterdata.dev", "custom_domain": true },
    { "pattern": "wildfiredata.dev", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "datasites-signups",
      // Replace with the id printed by: pnpm exec wrangler d1 create datasites-signups
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENV": "production",
    // Cloudflare's public test site key (always passes). Replace with your real Turnstile site key.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  }
}
