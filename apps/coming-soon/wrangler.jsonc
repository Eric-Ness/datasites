// The placeholder page for domains without a real site. deploy.yml does not deploy it: the sites launch
// straight to their real websites (WEB_SITES in deploy.yml). Deploy it by hand only to put a placeholder
// on a domain, once that zone is Active in Cloudflare; a domain can belong to only one Worker.
// Every site now serves its real website (web-<id>), so it holds no domains.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "datasites-coming-soon",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": true,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "routes": [],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "datasites-signups",
      // Created 2026-10-25 with: pnpm exec wrangler d1 create datasites-signups
      "database_id": "458a10f1-3b84-422a-83a5-2ed97e7e9ce4",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENV": "production",
    // Cloudflare's public test site key (always passes). Replace with your real Turnstile site key.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  }
}
