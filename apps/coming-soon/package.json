{
  "name": "@datasites/coming-soon",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply datasites-signups --local",
    "db:migrate:remote": "wrangler d1 migrations apply datasites-signups --remote",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@datasites/registry": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
