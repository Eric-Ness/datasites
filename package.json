{
  "name": "datasites",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen": "node scripts/gen-registry.mjs",
    "check:registry": "node scripts/gen-registry.mjs --check",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "dev:api": "pnpm --filter @datasites/api dev",
    "dev:coming-soon": "pnpm --filter @datasites/coming-soon dev"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
